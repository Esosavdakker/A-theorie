---
import '../styles/tokens.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { site } from '../config/site.config.js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = site.name,
  description = site.description,
  ogImage = '/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url);
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />

  <title>{pageTitle}</title>
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, site.url)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
</head>
<body>

  <Navbar />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- WhatsApp FAB -->
  <a href={site.social.whatsapp} class="whatsapp-fab" aria-label="Chat via WhatsApp" target="_blank" rel="noopener noreferrer">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <!-- Cookie banner -->
  <div id="cookie-banner" class="cookie-banner" role="region" aria-label="Cookiemelding" hidden>
    <div class="container cookie-banner__inner">
      <p class="cookie-banner__text">
        Deze website gebruikt alleen functionele cookies die nodig zijn voor de basisfunctionaliteit.
        Er worden geen tracking- of marketingcookies gebruikt.
        <a href="/cookieverklaring" class="cookie-banner__link">Lees onze cookieverklaring →</a>
      </p>
      <button id="cookie-accept">Akkoord</button>
    </div>
  </div>

</body>
</html>

<style is:global>
/* --- WhatsApp FAB --- */
.whatsapp-fab {
  position: fixed;
  bottom: var(--space-6);
  right: var(--space-6);
  z-index: var(--z-fab);
  width: 56px;
  height: 56px;
  border-radius: var(--radius-full);
  background: #25d366;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-white);
  box-shadow: 0 4px 20px rgb(37 211 102 / 0.45);
  transition: transform var(--duration-normal) var(--ease-spring),
              box-shadow var(--duration-normal) var(--ease-out);
  animation: pulse-ring 2.5s ease-in-out 3s infinite;
}
.whatsapp-fab:hover {
  transform: scale(1.12);
  box-shadow: 0 8px 32px rgb(37 211 102 / 0.55);
  animation: none;
}

@keyframes pulse-ring {
  0%, 100% { box-shadow: 0 4px 20px rgb(37 211 102 / 0.45); }
  50%       { box-shadow: 0 4px 20px rgb(37 211 102 / 0.45), 0 0 0 10px rgb(37 211 102 / 0.12); }
}

/* --- Cookie accept button --- */
#cookie-accept {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2) var(--space-5);
  font-family: var(--font-family-base);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  line-height: 1;
  white-space: nowrap;
  border: none;
  border-radius: var(--radius-sm);
  cursor: pointer;
  background: var(--gradient-accent);
  color: var(--color-white);
  box-shadow: var(--shadow-accent);
  transition: transform var(--duration-normal) var(--ease-spring),
              box-shadow var(--duration-normal) var(--ease-out);
}
#cookie-accept:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 28px rgb(249 115 22 / 0.45);
}
#cookie-accept:focus-visible {
  outline: 3px solid var(--color-accent);
  outline-offset: 3px;
}
#cookie-accept:active { transform: translateY(0) scale(0.98); }

/* --- Cookie banner --- */
.cookie-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 60;
  background: var(--color-white);
  border-top: 1px solid var(--color-border);
  box-shadow: 0 -4px 20px rgb(0 0 0 / 0.08);
  padding-block: var(--space-4);
}
.cookie-banner__inner {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  flex-wrap: wrap;
}
.cookie-banner__text {
  font-size: var(--font-size-sm);
  color: var(--color-text-muted);
  flex: 1;
  min-width: 16rem;
  line-height: var(--line-height-relaxed);
}
.cookie-banner__link {
  color: var(--color-primary);
  text-decoration: underline;
  text-underline-offset: 2px;
  white-space: nowrap;
}
@media (max-width: 599px) {
  .cookie-banner__inner { flex-direction: column; align-items: stretch; }
  .cookie-banner__inner .btn { justify-content: center; }
}
</style>

<script>
/* ---- Scroll reveal ---- */
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('revealed');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));

/* ---- Animated counter ---- */
function easeOutCubic(t: number) { return 1 - Math.pow(1 - t, 3); }

function animateCounter(el: Element) {
  const target  = parseInt((el as HTMLElement).dataset.target ?? '0', 10);
  const suffix  = (el as HTMLElement).dataset.suffix ?? '';
  const start   = performance.now();
  const dur     = 1800;

  function tick(now: number) {
    const progress = Math.min((now - start) / dur, 1);
    const val = Math.round(easeOutCubic(progress) * target);
    el.textContent = val.toLocaleString('nl-NL') + suffix;
    if (progress < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

const counterObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.querySelectorAll('[data-counter]').forEach(animateCounter);
      counterObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.5 });

document.querySelectorAll('[data-counter-group]').forEach(el => counterObserver.observe(el));

/* ---- Cookie banner ---- */
const cookieBanner = document.getElementById('cookie-banner') as HTMLElement | null;
const cookieAccept = document.getElementById('cookie-accept');
const fab          = document.querySelector('.whatsapp-fab') as HTMLElement | null;

if (!localStorage.getItem('cookies-ok') && cookieBanner) {
  cookieBanner.removeAttribute('hidden');
  const nudge = () => { if (fab) fab.style.bottom = `calc(var(--space-6) + ${cookieBanner.offsetHeight}px)`; };
  nudge();
  window.addEventListener('resize', nudge, { passive: true });
  cookieAccept?.addEventListener('click', () => {
    localStorage.setItem('cookies-ok', '1');
    cookieBanner.setAttribute('hidden', '');
    if (fab) fab.style.bottom = '';
    window.removeEventListener('resize', nudge);
  });
}
</script>

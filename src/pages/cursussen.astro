---
import BaseLayout from '../layouts/BaseLayout.astro';
import Courses from '../components/sections/Courses.astro';
import CTA from '../components/sections/CTA.astro';
---

<BaseLayout
  title="Cursussen"
  description="Bekijk onze theorie-cursuspakketten voor rijbewijs B. Kies het pakket dat bij jou past."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Onze cursussen</h1>
      <p class="page-hero__sub">Van basisoefening tot premium begeleiding — voor elk niveau is er een passend pakket.</p>
    </div>
  </section>
  <Courses />
  <section class="section howto">
    <div class="container">
      <h2 class="section__heading">Zo werkt het</h2>
      <p class="section__sub">In drie stappen ben je klaar voor je examen.</p>
      <div class="howto__steps">
        <div class="howto__step">
          <span class="howto__number">1</span>
          <h3>Kies je pakket</h3>
          <p>Selecteer het pakket dat bij jouw niveau en budget past.</p>
        </div>
        <div class="howto__step">
          <span class="howto__number">2</span>
          <h3>Start direct</h3>
          <p>Na betaling krijg je direct toegang tot al het oefenmateriaal.</p>
        </div>
        <div class="howto__step">
          <span class="howto__number">3</span>
          <h3>Slaag voor je examen</h3>
          <p>Oefen tot je klaar bent en ga met vertrouwen je examen in.</p>
        </div>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>

<style>
.page-hero {
  background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  color: var(--color-white);
  padding-block: var(--space-20);
  text-align: center;
}
.page-hero__title {
  font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-5xl));
  font-weight: var(--font-weight-extrabold);
  margin-bottom: var(--space-4);
}
.page-hero__sub {
  font-size: var(--font-size-lg);
  opacity: 0.9;
  max-width: 560px;
  margin-inline: auto;
}
.howto__steps {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  counter-reset: steps;
}
.howto__step {
  text-align: center;
  padding: var(--space-8);
  background: var(--color-bg);
  border-radius: var(--radius-xl);
}
.howto__number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: var(--radius-full);
  background: var(--color-primary);
  color: var(--color-white);
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-extrabold);
  margin-bottom: var(--space-4);
}
.howto__step h3 {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  margin-bottom: var(--space-2);
}
.howto__step p { color: var(--color-text-muted); line-height: var(--line-height-relaxed); }
@media (min-width: 768px) {
  .howto__steps { grid-template-columns: repeat(3, 1fr); }
}
</style>

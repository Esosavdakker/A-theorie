---
import BaseLayout from '../layouts/BaseLayout.astro';
import Input from '../components/ui/Input.astro';
import Button from '../components/ui/Button.astro';
import { site } from '../config/site.config.js';
---

<BaseLayout
  title="Contact"
  description="Neem contact op met A+theorie. We beantwoorden je vraag binnen 24 uur."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Neem contact op</h1>
      <p class="page-hero__sub">Vragen over onze cursussen? We helpen je graag. We reageren binnen 24 uur.</p>
    </div>
  </section>

  <section class="contact section">
    <div class="container contact__grid">
      <address class="contact__info" style="font-style: normal;">
        <h2 class="contact__info-heading">Contactgegevens</h2>

        <div class="contact__detail">
          <span class="contact__detail-icon" aria-hidden="true">📍</span>
          <div>
            <p>{site.address.street}</p>
            <p>{site.address.postalCode} {site.address.city}</p>
          </div>
        </div>

        <div class="contact__detail">
          <span class="contact__detail-icon" aria-hidden="true">📞</span>
          <a href={`tel:${site.phone}`} class="contact__link">{site.phone}</a>
        </div>

        <div class="contact__detail">
          <span class="contact__detail-icon" aria-hidden="true">✉️</span>
          <a href={`mailto:${site.email}`} class="contact__link">{site.email}</a>
        </div>

        <div class="contact__detail">
          <span class="contact__detail-icon" aria-hidden="true">💬</span>
          <a href={site.social.whatsapp} class="contact__link" target="_blank" rel="noopener noreferrer">
            WhatsApp ons
          </a>
        </div>

        <div class="contact__hours">
          <h3>Openingstijden</h3>
          <p>Ma–Vr: 09:00–17:00</p>
          <p>Za–Zo: Gesloten</p>
        </div>
      </address>

      <div class="contact__form-wrapper">
        <h2 class="contact__form-heading">Stuur een bericht</h2>
        <form class="contact__form" id="contact-form" novalidate>
          <div style="display:none" aria-hidden="true">
            <label for="website">Laat dit veld leeg</label>
            <input type="text" id="website" name="honeypot" tabindex="-1" autocomplete="off" />
          </div>

          <Input label="Naam" name="name" placeholder="Jan Janssen" required />
          <Input label="E-mailadres" name="email" type="email" placeholder="jan@email.nl" required />
          <Input label="Telefoonnummer" name="phone" type="tel" placeholder="+31 6 12345678" />
          <Input label="Bericht" name="message" type="textarea" placeholder="Hoe kunnen we je helpen?" required rows={5} />

          <Button type="submit" variant="primary" size="lg" id="submit-btn" class="contact__submit">
            Verstuur bericht
          </Button>

          <div id="form-status" class="form-status" role="alert" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !statusEl) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Versturen...';
    statusEl.textContent = '';
    statusEl.className = 'form-status';

    const data = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (res.ok) {
        statusEl.textContent = json.message ?? 'Bericht ontvangen!';
        statusEl.classList.add('form-status--success');
        form.reset();
      } else {
        statusEl.textContent = json.error ?? 'Er is iets misgegaan.';
        statusEl.classList.add('form-status--error');
      }
    } catch {
      statusEl.textContent = 'Netwerkfout. Probeer het later opnieuw.';
      statusEl.classList.add('form-status--error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Verstuur bericht';
    }
  });
</script>

<style>
.page-hero {
  background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  color: var(--color-white);
  padding-block: var(--space-20);
  text-align: center;
}
.page-hero__title {
  font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-5xl));
  font-weight: var(--font-weight-extrabold);
  margin-bottom: var(--space-4);
}
.page-hero__sub {
  font-size: var(--font-size-lg);
  opacity: 0.9;
  max-width: 560px;
  margin-inline: auto;
}
.contact__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-12);
}
.contact__info-heading, .contact__form-heading {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  margin-bottom: var(--space-6);
}
.contact__detail {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
  margin-bottom: var(--space-5);
}
.contact__detail-icon { font-size: var(--font-size-lg); flex-shrink: 0; margin-top: 2px; }
.contact__link { color: var(--color-primary); font-weight: var(--font-weight-medium); }
.contact__link:hover { text-decoration: underline; }
.contact__hours {
  margin-top: var(--space-8);
  padding: var(--space-6);
  background: var(--color-bg);
  border-radius: var(--radius-lg);
  border-left: 4px solid var(--color-accent);
}
.contact__hours h3 {
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary);
  margin-bottom: var(--space-2);
}
.contact__hours p { color: var(--color-text-muted); font-size: var(--font-size-sm); }
.contact__form { display: flex; flex-direction: column; gap: var(--space-5); }
.contact__submit { align-self: flex-start; }
.form-status {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
}
.form-status:empty { display: none; }
.form-status--success { background: #dcfce7; color: #166534; }
.form-status--error   { background: #fee2e2; color: #991b1b; }
@media (min-width: 768px) {
  .contact__grid { grid-template-columns: 1fr 1.5fr; }
}
</style>

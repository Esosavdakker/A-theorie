---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/sections/About.astro';
import CTA from '../components/sections/CTA.astro';
---

<BaseLayout
  title="Over Ons"
  description="Leer meer over A+theorie en onze missie om elke cursist te laten slagen voor zijn theorie-examen."
>
  <section class="page-hero">
    <div class="container">
      <h1 class="page-hero__title">Over A+theorie</h1>
      <p class="page-hero__sub">Wij geloven dat iedereen zijn rijbewijs kan halen met de juiste voorbereiding.</p>
    </div>
  </section>
  <About />
  <section class="section mission">
    <div class="container mission__inner">
      <div class="mission__block">
        <h2>Onze missie</h2>
        <p>
          A+theorie is opgericht met één doel: elke cursist zo goed mogelijk voorbereiden op het CBR-theorie-examen.
          We combineren officieel CBR-materiaal met moderne leertools en persoonlijke ondersteuning.
        </p>
      </div>
      <div class="mission__block">
        <h2>Onze aanpak</h2>
        <p>
          Oefen met duizenden vragen, bekijk video-uitleg per onderwerp en volg je eigen voortgang nauwkeurig.
          Ons platform is beschikbaar op alle apparaten, zodat je altijd en overal kunt leren.
        </p>
      </div>
      <div class="mission__block">
        <h2>Kwaliteitsgarantie</h2>
        <p>
          Al ons materiaal wordt regelmatig bijgewerkt op basis van de nieuwste CBR-richtlijnen.
          Premium cursisten profiteren van onze geld-terug-garantie als ze niet slagen.
        </p>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>

<style>
.page-hero {
  background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
  color: var(--color-white);
  padding-block: var(--space-20);
  text-align: center;
}
.page-hero__title {
  font-size: clamp(var(--font-size-3xl), 4vw, var(--font-size-5xl));
  font-weight: var(--font-weight-extrabold);
  margin-bottom: var(--space-4);
}
.page-hero__sub {
  font-size: var(--font-size-lg);
  opacity: 0.9;
  max-width: 560px;
  margin-inline: auto;
}
.mission__inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
}
.mission__block {
  background: var(--color-bg);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  border-left: 4px solid var(--color-accent);
}
.mission__block h2 {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  margin-bottom: var(--space-3);
}
.mission__block p {
  color: var(--color-text-muted);
  line-height: var(--line-height-relaxed);
}
@media (min-width: 768px) {
  .mission__inner { grid-template-columns: repeat(3, 1fr); }
}
</style>

---
interface Props {
  highlighted?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { highlighted = false, class: className = '', ...rest } = Astro.props;
---

<div class:list={['card', { 'card--highlighted': highlighted }, className]} {...rest}>
  <slot />
</div>

<style>
.card {
  background: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  box-shadow: var(--shadow-md);
  transition: box-shadow var(--duration-normal) var(--ease-out),
              transform var(--duration-normal) var(--ease-spring);
  position: relative;
}
.card:hover {
  box-shadow: var(--shadow-primary);
  transform: translateY(-3px);
}
.card--highlighted {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 2px var(--color-accent), var(--shadow-lg);
}
.card--highlighted:hover {
  box-shadow: 0 0 0 2px var(--color-accent), var(--shadow-accent);
  transform: translateY(-4px);
}
</style>

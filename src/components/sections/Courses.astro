---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { site } from '../../config/site.config.js';
---

<section class="courses section" id="cursussen">
  <div class="container">
    <p class="section__label" data-reveal>Onze cursussen</p>
    <h2 class="section__heading" data-reveal data-delay="1">Kies jouw pakket</h2>
    <p class="section__sub" data-reveal data-delay="2">Begin vandaag nog — direct toegang na aanmelding.</p>
    <div class="courses__wrapper">
    <div class="courses__grid">
      {site.courses.map((course, i) => (
        <Card highlighted={!!course.badge} data-reveal data-delay={String(i + 1)}>
          {course.badge && <span class="courses__badge">{course.badge}</span>}
          <h3 class="courses__title">{course.title}</h3>
          <p class="courses__desc">{course.description}</p>
          <ul class="courses__includes" role="list">
            {course.includes.map(item => (
              <li class="courses__include">
                <span class="courses__check" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="2 7 5.5 10.5 12 3.5"/>
                  </svg>
                </span>
                {item}
              </li>
            ))}
          </ul>
          <Button href={course.cta.href} variant={course.badge ? 'primary' : 'secondary'} class="courses__cta" arrow>
            {course.cta.label}
          </Button>
        </Card>
      ))}
    </div>
    </div>
  </div>
</section>

<style>
.courses__wrapper {
  max-width: 52rem;
  margin-inline: auto;
}
.courses__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  align-items: stretch;
}
:global(#cursussen .card) {
  display: flex;
  flex-direction: column;
}
.courses__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  background: var(--gradient-accent);
  color: var(--color-white);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-4);
  box-shadow: 0 2px 8px rgb(249 115 22 / 0.3);
}
.courses__title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary);
  margin-bottom: var(--space-3);
}
.courses__desc {
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
  margin-bottom: var(--space-6);
  line-height: var(--line-height-relaxed);
}
.courses__includes {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-8);
}
.courses__include {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: var(--font-size-sm);
  color: var(--color-text);
}
.courses__check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  background: rgb(0 102 204 / 0.08);
  color: var(--color-primary);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.courses__cta { width: 100%; justify-content: center; margin-top: auto; }

@media (min-width: 768px) {
  .courses__grid { grid-template-columns: repeat(2, 1fr); }
}
</style>

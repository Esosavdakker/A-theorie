---
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { site } from '../../config/site.config.js';
---

<section class="courses section" id="cursussen">
  <div class="container">
    <h2 class="section__heading">Onze cursussen</h2>
    <p class="section__sub">Kies het pakket dat bij jou past en begin vandaag nog.</p>
    <div class="courses__grid">
      {site.courses.map(course => (
        <Card highlighted={!!course.badge}>
          {course.badge && <span class="courses__badge">{course.badge}</span>}
          <h3 class="courses__title">{course.title}</h3>
          <p class="courses__desc">{course.description}</p>
          <ul class="courses__includes" role="list">
            {course.includes.map(item => (
              <li class="courses__include">
                <span class="courses__check" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>
          <Button href={course.cta.href} variant={course.badge ? 'primary' : 'secondary'} class="courses__cta">
            {course.cta.label}
          </Button>
        </Card>
      ))}
    </div>
  </div>
</section>

<style>
.courses__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}
.courses__badge {
  display: inline-block;
  background: var(--color-accent);
  color: var(--color-white);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-full);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: var(--space-4);
}
.courses__title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-primary-dark);
  margin-bottom: var(--space-3);
}
.courses__desc {
  font-size: var(--font-size-base);
  color: var(--color-text-muted);
  margin-bottom: var(--space-6);
  line-height: var(--line-height-relaxed);
}
.courses__includes { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-8); }
.courses__include {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: var(--font-size-sm);
}
.courses__check {
  color: var(--color-accent);
  font-weight: var(--font-weight-bold);
  flex-shrink: 0;
}
.courses__cta { width: 100%; justify-content: center; }

@media (min-width: 768px) {
  .courses__grid { grid-template-columns: repeat(3, 1fr); }
}
</style>

---
import Button from '../ui/Button.astro';
import { site } from '../../config/site.config.js';
const { cta } = site;
---

<section class="cta-section">
  <div class="container cta__inner">
    <p class="cta__eyebrow" data-reveal>Klaar om te starten?</p>
    <h2 class="cta__heading" data-reveal data-delay="1">{cta.heading}</h2>
    <p class="cta__body" data-reveal data-delay="2">{cta.body}</p>

    <div class="cta__action" data-reveal data-delay="3">
      <Button href={cta.button.href} variant="primary" size="lg" arrow>
        {cta.button.label}
      </Button>
    </div>

    {cta.trust && (
      <div class="cta__trust" data-reveal data-delay="4">
        {cta.trust.map(t => (
          <span class="cta__trust-item">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="2 7 5.5 10.5 12 3.5"/>
            </svg>
            {t}
          </span>
        ))}
      </div>
    )}

    <div class="cta__social" data-reveal data-delay="5">
      <div class="cta__avatars" aria-hidden="true">
        {Array.from({ length: 5 }).map((_, i) => (
          <div class="cta__avatar" style={`background: hsl(${210 + i * 25}, 70%, 55%)`}>{i + 1}</div>
        ))}
      </div>
      <span class="cta__social-text">5.000+ cursisten gingen je voor</span>
    </div>
  </div>
</section>

<style>
.cta-section {
  background: var(--gradient-primary);
  padding-block: var(--space-20);
  position: relative;
  overflow: hidden;
}
.cta-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse 70% 60% at 50% 100%, rgb(249 115 22 / 0.12), transparent);
  pointer-events: none;
}
.cta__inner {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-5);
  position: relative;
}
.cta__eyebrow {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  color: rgb(249 115 22 / 0.9);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.cta__heading {
  font-size: clamp(var(--font-size-2xl), 3.5vw, var(--font-size-4xl));
  font-weight: var(--font-weight-extrabold);
  color: var(--color-white);
  letter-spacing: -0.02em;
  line-height: var(--line-height-tight);
  max-width: 560px;
}
.cta__body {
  font-size: var(--font-size-lg);
  color: rgb(255 255 255 / 0.8);
  max-width: 480px;
  line-height: var(--line-height-relaxed);
}
.cta__action { margin-top: var(--space-2); }

.cta__trust {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--space-4);
  margin-top: var(--space-1);
}
.cta__trust-item {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-size: var(--font-size-sm);
  color: rgb(255 255 255 / 0.75);
}
.cta__trust-item svg { color: rgb(249 115 22 / 0.85); flex-shrink: 0; }

.cta__social {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-top: var(--space-2);
}
.cta__avatars {
  display: flex;
  flex-direction: row-reverse;
}
.cta__avatar {
  width: 30px;
  height: 30px;
  border-radius: var(--radius-full);
  border: 2px solid var(--color-primary-dark);
  color: var(--color-white);
  font-size: 10px;
  font-weight: var(--font-weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -8px;
}
.cta__avatar:last-child { margin-left: 0; }
.cta__social-text {
  font-size: var(--font-size-sm);
  color: rgb(255 255 255 / 0.75);
}
</style>
